<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders every page of the real MicMix window in demo mode to PNGs for the README.
       Run from the repo root: dotnet run -c Release (project tools/Screenshots), arguments: docs/screenshots 700 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- MicMix itself is self-contained only for its Release single-file exe; we just load its assembly. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MicMix\MicMix.csproj" />
  </ItemGroup>

</Project>
