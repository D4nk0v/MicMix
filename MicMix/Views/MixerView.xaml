<UserControl x:Class="MicMix.Views.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MicMix.ViewModels">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Микшер" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18"
                   Text="Твой голос и выбранные программы уходят в один микрофон — CABLE Output в Discord, играх и OBS." />

        <!-- Things that need the user -->
        <Border Style="{StaticResource Banner}" Background="{StaticResource WarnSoftBrush}" BorderBrush="{StaticResource WarnBrush}"
                Visibility="{Binding VbCableMissing, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Установить" Click="OpenSetup_Click" VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Нужен виртуальный микрофон VB-Cable" />
                    <TextBlock Style="{StaticResource Hint}" Text="Через него MicMix отдаёт звук в Discord и игры. Установка займёт минуту." />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Banner}" Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorBrush}"
                Visibility="{Binding HasLoopWarning, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Лишний звук в микрофоне" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding LoopWarning}" />
            </StackPanel>
        </Border>

        <!-- My voice -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource IconToggle}" IsChecked="{Binding MicMuted}"
                                  ToolTip="Выключить мой голос (Ctrl+Alt+K по умолчанию)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE720;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MicMuted}" Value="True">
                                                <Setter Property="Text" Value="&#xEC54;" />
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Включён" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MicMuted}" Value="True">
                                                <Setter Property="Text" Value="Выключен" />
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ToggleButton>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="18" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Мой голос" />
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding MicName}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>

                <ProgressBar Style="{StaticResource Meter}" Value="{Binding MicLevel, Mode=OneWay}" Margin="0,16,0,12" />

                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Hint}" Text="Громкость" Width="90" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding MicVolumePercent, StringFormat={}{0:0}%}" Width="44"
                               TextAlignment="Right" VerticalAlignment="Center" />
                    <Slider Minimum="0" Maximum="200" Value="{Binding MicVolumePercent}" VerticalAlignment="Center"
                            IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10" />
                </DockPanel>

                <Border Style="{StaticResource Divider}" />

                <DockPanel>
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource IconToggle}" IsChecked="{Binding MonitorEnabled}"
                                  ToolTip="Слышать свой обработанный голос в наушниках">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F6;" FontSize="14" />
                            <TextBlock Text="Послушать себя" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center"
                                ToolTip="Горит, когда MicMix слышит, что ты говоришь">
                        <Ellipse Width="8" Height="8">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource HairlineStrongBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VoiceActive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Style="{StaticResource Hint}" Text="голос" Margin="6,0,0,0" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Voice.Enabled}">
                        <StackPanel>
                            <TextBlock Text="Чистый голос" FontSize="14" />
                            <TextBlock Style="{StaticResource Hint}" Text="шумодав, гейт, эквалайзер, компрессор" />
                        </StackPanel>
                    </CheckBox>
                </DockPanel>

                <DockPanel Margin="0,14,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Click="OpenEffects_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Пресеты" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11" Margin="6,1,0,0"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Button>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding VoiceFx.Enabled}">
                        <StackPanel>
                            <TextBlock Text="Войс-ченджер" FontSize="14" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding VoiceFxSummary}" />
                        </StackPanel>
                    </CheckBox>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Apps -->
        <Border Style="{StaticResource Card}" Padding="0,16,0,8">
            <StackPanel>
                <DockPanel Margin="18,0,18,4">
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource IconToggle}" IsChecked="{Binding AppBus.Muted}"
                                  ToolTip="Убрать все программы из микрофона, не снимая галочек (Ctrl+Alt+N)">
                        <TextBlock FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="&#xE767;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppBus.Muted}" Value="True">
                                            <Setter Property="Text" Value="&#xE74F;" />
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ToggleButton>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AppBus.Ducking}" Margin="0,0,16,0"
                              ToolTip="Пока ты говоришь, музыка становится тише">
                        <TextBlock Style="{StaticResource Hint}" Text="тише, когда говорю" />
                    </CheckBox>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="18" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Программы в микрофон" />
                        <TextBlock Style="{StaticResource Hint}" Text="Отмеченное слышат друзья. Остальное — только ты." />
                    </StackPanel>
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource ErrorBrush}" Margin="18,4,18,0"
                           Text="Все программы сейчас убраны из микрофона."
                           Visibility="{Binding AppBus.Muted, Converter={StaticResource BoolToVis}}" />

                <TextBlock Style="{StaticResource Hint}" Margin="18,14,18,8"
                           Text="Сейчас ни одна программа не играет звук. Включи музыку или видео — программа появится здесь."
                           Visibility="{Binding VisibleApps.Count, Converter={StaticResource InverseVis}}" />

                <ItemsControl ItemsSource="{Binding VisibleApps}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AppItemViewModel}">
                            <Border x:Name="Row" Padding="18,8" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,8,0"
                                              ToolTip="Слышно в микрофоне" />
                                    <Grid Grid.Column="1" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <!-- Placeholder for protected or icon-less programs -->
                                        <Border CornerRadius="6" Background="#1AFFFFFF">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE737;" FontSize="12" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </Border>
                                        <Image Source="{Binding Icon}" />
                                    </Grid>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"
                                                   Text="Голосовой чат: друзья услышат сами себя с эхом. Включай, только если точно нужно."
                                                   Visibility="{Binding ShowVoiceChatWarning, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <Slider Grid.Column="3" Minimum="0" Maximum="200" Value="{Binding VolumePercent}" VerticalAlignment="Center"
                                            IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"
                                            ToolTip="Громкость этой программы в микрофоне"
                                            Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Grid.Column="4" Text="{Binding VolumePercent, StringFormat={}{0:0}%}" TextAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                                               Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}" />
                                    <ProgressBar Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource Meter}" Height="3"
                                                 Margin="0,6,0,0" Value="{Binding Level, Mode=OneWay}"
                                                 Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#08FFFFFF" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ToggleButton Margin="18,6,18,4" HorizontalAlignment="Left" IsChecked="{Binding ShowAllApps}" Cursor="Hand">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <ContentPresenter />
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <TextBlock FontSize="13" Foreground="{StaticResource AccentBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding HiddenAppsCount, StringFormat=Показать все программы ({0})}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowAllApps}" Value="True">
                                        <Setter Property="Text" Value="Показывать только играющие и отмеченные" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ShowAllApps}" Value="False" />
                                            <Condition Binding="{Binding HiddenAppsCount}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ToggleButton>
            </StackPanel>
        </Border>

        <!-- What leaves -->
        <DockPanel Margin="4,2,4,0">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Hint}" Text="Уходит в микрофон" Width="140" VerticalAlignment="Center" />
            <ProgressBar Style="{StaticResource Meter}" Value="{Binding OutputLevel, Mode=OneWay}" VerticalAlignment="Center" />
        </DockPanel>
    </StackPanel>
</UserControl>
