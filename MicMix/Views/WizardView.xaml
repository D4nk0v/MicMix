<UserControl x:Class="MicMix.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StepBar" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Background" Value="{StaticResource HairlineStrongBrush}" />
        </Style>
        <Style x:Key="BigIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="LineHeight" Value="21" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Border Width="540" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource Card}" Padding="36,30">
            <StackPanel>
                <!-- Progress -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,26">
                    <Border Style="{StaticResource StepBar}" Background="{StaticResource AccentBrush}" />
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepBar}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WizardStep}" Value="2"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding WizardStep}" Value="3"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepBar}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WizardStep}" Value="3"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>

                <!-- Step 1: VB-Cable -->
                <StackPanel Visibility="{Binding WizardStep, Converter={StaticResource EqualsVis}, ConverterParameter=1}" MinHeight="250">
                    <TextBlock Style="{StaticResource BigIcon}" Text="&#xE703;" />
                    <TextBlock Style="{StaticResource StepTitle}" Text="Виртуальный микрофон" />
                    <TextBlock Style="{StaticResource StepText}"
                               Text="MicMix смешивает твой голос с музыкой и отдаёт результат в Discord и игры через бесплатный драйвер VB-Cable от VB-Audio." />

                    <Border Style="{StaticResource Banner}" Background="{StaticResource OkSoftBrush}" BorderBrush="{StaticResource OkBrush}"
                            Margin="0,22,0,0" HorizontalAlignment="Center"
                            Visibility="{Binding CableInstalled, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource OkBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="VB-Cable уже установлен — можно дальше" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding CableInstalled, Converter={StaticResource InverseVis}}" Margin="0,22,0,0">
                        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="Install_Click"
                                IsEnabled="{Binding IsInstallingCable, Converter={StaticResource InverseBool}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" Foreground="{StaticResource OnAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Установить VB-Cable" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource StepText}" FontSize="12" Margin="0,12,0,0" Text="{Binding InstallStatus}" />
                        <TextBlock Style="{StaticResource StepText}" FontSize="12" Margin="0,8,0,0"
                                   Text="Скачаю с vb-audio.com и проверю подпись. Windows спросит разрешение — нажми «Да», затем в окне VB-Cable «Install Driver». После установки лучше перезагрузить компьютер." />
                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,10,0,0"
                                Content="Скачать вручную с сайта" Click="OpenPage_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- Step 2: microphone -->
                <StackPanel Visibility="{Binding WizardStep, Converter={StaticResource EqualsVis}, ConverterParameter=2}" MinHeight="250">
                    <TextBlock Style="{StaticResource BigIcon}" Text="&#xE720;" />
                    <TextBlock Style="{StaticResource StepTitle}" Text="Твой микрофон" />
                    <TextBlock Style="{StaticResource StepText}" Text="Выбери настоящий микрофон, в который ты говоришь." Margin="0,0,0,18" />
                    <ComboBox ItemsSource="{Binding Mics}" SelectedItem="{Binding SelectedMic}" HorizontalAlignment="Stretch" />
                    <ProgressBar Style="{StaticResource Meter}" Value="{Binding MicLevel, Mode=OneWay}" Margin="0,16,0,8" />
                    <TextBlock Style="{StaticResource StepText}" FontSize="12"
                               Text="Скажи что-нибудь — полоска должна двигаться. Пресет обработки голоса подберётся под этот микрофон." />
                    <TextBlock Style="{StaticResource StepText}" FontSize="12" Foreground="{StaticResource WarnBrush}" Margin="0,6,0,0"
                               Text="Полоска оживёт после установки VB-Cable."
                               Visibility="{Binding VbCableMissing, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Step 3: where to pick it -->
                <StackPanel Visibility="{Binding WizardStep, Converter={StaticResource EqualsVis}, ConverterParameter=3}" MinHeight="250">
                    <TextBlock Style="{StaticResource BigIcon}" Text="&#xE8BD;" />
                    <TextBlock Style="{StaticResource StepTitle}" Text="Последний шаг" />
                    <TextBlock Style="{StaticResource StepText}" Margin="0,0,0,18"
                               Text="Скажи Discord и играм слушать MicMix вместо обычного микрофона." />
                    <Border Style="{StaticResource Card}" Margin="0" Padding="16,14">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                <Bold>Discord:</Bold> Настройки → Голос и видео → Устройство ввода → <Bold>CABLE Output</Bold>.
                                Там же выключи шумоподавление, эхоподавление и автоусиление.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                <Bold>Игры</Bold> (Rust и др.): выбери <Bold>CABLE Output</Bold> в настройках звука игры. Если выбора нет —
                                Параметры Windows → Система → Звук → Ввод → <Bold>CABLE Output</Bold>.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap">
                                <Bold>OBS:</Bold> загляни во вкладку «Стрим».
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Buttons -->
                <DockPanel Margin="0,26,0,0">
                    <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="Пропустить" Click="Skip_Click"
                            VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Назад" Click="Back_Click" Margin="0,0,10,0" Padding="16,8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WizardStep}" Value="1"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="Next_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Content" Value="Далее" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WizardStep}" Value="3"><Setter Property="Content" Value="Готово" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
