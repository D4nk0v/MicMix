<Application x:Class="MicMix.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:MicMix.Views"
             ThemeMode="Dark"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <v:InverseVisibilityConverter x:Key="InverseVis" />
        <v:EnumIsConverter x:Key="EnumIs" />
        <v:EqualsToVisibilityConverter x:Key="EqualsVis" />
        <v:PositiveToVisibilityConverter x:Key="PositiveVis" />
        <v:PercentConverter x:Key="Percent" />
        <v:InverseBoolConverter x:Key="InverseBool" />
        <v:EnabledOpacityConverter x:Key="EnabledOpacity" />

        <!-- Palette. MicMix green is the accent everywhere, including the built-in Fluent controls
             (overriding their accent keys), so the app looks the same whatever the Windows accent is. -->
        <Color x:Key="SystemAccentColor">#34A06E</Color>
        <Color x:Key="SystemAccentColorLight1">#3BAA76</Color>
        <Color x:Key="SystemAccentColorLight2">#4CC38A</Color>
        <Color x:Key="SystemAccentColorLight3">#7ED9AC</Color>
        <Color x:Key="SystemAccentColorDark1">#2E8F62</Color>
        <Color x:Key="SystemAccentColorDark2">#22714C</Color>
        <Color x:Key="SystemAccentColorDark3">#165238</Color>
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4CC38A" />
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E64CC38A" />
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC4CC38A" />
        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#7ED9AC" />
        <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#7ED9AC" />
        <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#4CC38A" />
        <!-- Fluent picks these up via StaticResource inside its own dictionaries, so they need their own overrides. -->
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#4CC38A" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#7ED9AC" />
        <SolidColorBrush x:Key="SliderInnerThumb" Color="#4CC38A" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#4CC38A" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#66D19D" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#3BAA76" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#4CC38A" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#66D19D" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#3BAA76" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4CC38A" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#4D4CC38A" />
        <SolidColorBrush x:Key="OnAccentBrush" Color="#E6000000" />
        <SolidColorBrush x:Key="WindowBrush" Color="#141518" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#0F1012" />
        <SolidColorBrush x:Key="CardBrush" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#15FFFFFF" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="HairlineStrongBrush" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9EFFFFFF" />
        <SolidColorBrush x:Key="FaintTextBrush" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="OkBrush" Color="#4CC38A" />
        <SolidColorBrush x:Key="OkSoftBrush" Color="#264CC38A" />
        <SolidColorBrush x:Key="WarnBrush" Color="#F2B84B" />
        <SolidColorBrush x:Key="WarnSoftBrush" Color="#26F2B84B" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#F0646A" />
        <SolidColorBrush x:Key="ErrorSoftBrush" Color="#26F0646A" />
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <!-- Brand gradient: MicMix green drifting to teal. Used sparingly: selection, primary actions, meters. -->
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5AD69A" Offset="0" />
            <GradientStop Color="#2FB5A8" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGlowBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2E4CC38A" Offset="0" />
            <GradientStop Color="#142FB5A8" Offset="1" />
        </LinearGradientBrush>
        <!-- Level meter: green for normal speech, amber near the top, red only right at clipping. -->
        <LinearGradientBrush x:Key="MeterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2FB5A8" Offset="0" />
            <GradientStop Color="#5AD69A" Offset="0.6" />
            <GradientStop Color="#F2B84B" Offset="0.86" />
            <GradientStop Color="#F0646A" Offset="1" />
        </LinearGradientBrush>

        <!-- Text -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <!-- Containers -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource HairlineBrush}" />
            <Setter Property="Margin" Value="0,14" />
        </Style>
        <Style x:Key="Banner" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Level meter. The gradient spans the whole track and the indicator only reveals it,
             so colour means loudness (amber/red appear only when the level really gets there). -->
        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource MeterBrush}" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" ClipToBounds="True">
                                    <Rectangle HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}"
                                               Width="{Binding ActualWidth, ElementName=PART_Track}" />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FaintTextBrush}" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>

        <!-- Big selectable tile (voice changer presets): icon, name, one-line description. -->
        <Style x:Key="Tile" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="12" BorderThickness="1" Padding="14,14,14,12"
                                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource HairlineBrush}">
                                <StackPanel>
                                    <Border x:Name="IconBg" Width="36" Height="36" CornerRadius="10" HorizontalAlignment="Left"
                                            Background="#14FFFFFF" Margin="0,0,0,10">
                                        <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" FontSize="18"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                    <ContentPresenter />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentGlowBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="IconBg" Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle switch (CheckBox) -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="40" Height="20" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                        BorderBrush="{StaticResource MutedTextBrush}" Background="Transparent" />
                                <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                         Fill="{StaticResource MutedTextBrush}" />
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource OnAccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Width" Value="14" />
                                <Setter TargetName="Thumb" Property="Height" Value="14" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar navigation item -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="12,9">
                            <Grid>
                                <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                        Margin="-12,0,0,0" Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" Foreground="{TemplateBinding Foreground}" />
                                    <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" TextElement.FontSize="14" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented chip (preset picker) -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="15" BorderThickness="1" Padding="14,6"
                                BorderBrush="{StaticResource HairlineStrongBrush}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="13" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round icon toggle (mute, listen) -->
        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="17" Height="34" MinWidth="34" Padding="10,0"
                                Background="#0FFFFFFF" BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text-only link button -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter TextElement.FontSize="13" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary (accent-filled) button: at most one per screen -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Status pill colours, driven by EngineState -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter Property="Background" Value="{StaticResource OkSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter Property="Background" Value="{StaticResource ErrorSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
