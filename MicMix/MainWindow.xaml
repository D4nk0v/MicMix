<Window x:Class="MicMix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MicMix.Views"
        Title="MicMix" Width="900" Height="680" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen" Icon="/Assets/MicMix.ico"
        Background="{StaticResource WindowBrush}">
    <Grid>
        <!-- Shell: sidebar + page -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,18,12,14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,22">
                        <Image Source="/Assets/MicMix.ico" Width="26" Height="26" />
                        <TextBlock Text="MicMix" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Mini status, always visible -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusPill}" CornerRadius="8" Padding="10,8">
                        <DockPanel>
                            <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding StatusText}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <StackPanel>
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9E9;" Content="Микшер"
                                     IsChecked="{Binding Page, Converter={StaticResource EnumIs}, ConverterParameter=Mixer}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE720;" Content="Голос"
                                     IsChecked="{Binding Page, Converter={StaticResource EnumIs}, ConverterParameter=Voice}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE99A;" Content="Эффекты"
                                     IsChecked="{Binding Page, Converter={StaticResource EnumIs}, ConverterParameter=Effects}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE93E;" Content="Стрим"
                                     IsChecked="{Binding Page, Converter={StaticResource EnumIs}, ConverterParameter=Stream}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Настройки"
                                     IsChecked="{Binding Page, Converter={StaticResource EnumIs}, ConverterParameter=Settings}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="28,22,28,24" MaxWidth="760" HorizontalAlignment="Stretch">
                    <views:MixerView Visibility="{Binding Page, Converter={StaticResource EqualsVis}, ConverterParameter=Mixer}" />
                    <views:VoiceView Visibility="{Binding Page, Converter={StaticResource EqualsVis}, ConverterParameter=Voice}" />
                    <views:EffectsView Visibility="{Binding Page, Converter={StaticResource EqualsVis}, ConverterParameter=Effects}" />
                    <views:StreamView Visibility="{Binding Page, Converter={StaticResource EqualsVis}, ConverterParameter=Stream}" />
                    <views:SettingsView Visibility="{Binding Page, Converter={StaticResource EqualsVis}, ConverterParameter=Settings}" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- First-run setup covers everything until finished or skipped -->
        <views:WizardView Visibility="{Binding ShowWizard, Converter={StaticResource BoolToVis}}" />
    </Grid>
</Window>
